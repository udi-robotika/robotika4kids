{
  "buildCommand": "",
  "outputDirectory": "site",
  "trailingSlash": false,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/kids/leads",
      "destination": "https://www.robotika.co.il/kids/leads",
      "permanent": false
    },
    {
      "source": "/kids",
      "destination": "/השאירו-פרטים",
      "permanent": false
    }
  ]
}